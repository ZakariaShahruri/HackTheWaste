# Copy to application-local.yml (gitignored) and run with
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
# to try the AI scoring and WhatsApp flow locally.
leuvengo:
  gemini:
    api-key: PASTE_YOUR_GEMINI_API_KEY_HERE
  twilio:
    account-sid: PASTE_YOUR_TWILIO_ACCOUNT_SID_HERE
    auth-token: PASTE_YOUR_TWILIO_AUTH_TOKEN_HERE
