# Production settings. On Cloud Run, Terraform (infra/) sets all of these;
# fill them in by hand only when hosting the backend somewhere else.

# Activation
SPRING_PROFILES_ACTIVE=prod

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/leuvengo?sslmode=require
SPRING_DATASOURCE_USERNAME=leuvengo
SPRING_DATASOURCE_PASSWORD=your-password

# CORS — your Vercel frontend URL
ALLOWED_ORIGINS=https://your-app.vercel.app

# ML service URL; on Cloud Run the ML service is private and only accepts
# calls with a Google ID token from the backend's service account
ML_API_URL=https://your-ml-service.a.run.app
ML_GOOGLE_ID_TOKEN=true

# Long random string; keys the HMAC that replaces phone numbers. Keep it stable.
PSEUDONYM_SECRET=

# External APIs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Exact public URL configured in the Twilio console; webhook signatures are checked against it
TWILIO_WEBHOOK_URL=https://your-backend.a.run.app/api/whatsapp/webhook
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=trash-photos

# Demo instance: a week of seeded reports plus the public crew login (default true)
LEUVENGO_DEMO_ENABLED=true
# Nightly wipe-and-reseed of demo reports (Europe/Brussels); "-" turns it off
LEUVENGO_DEMO_RESET_CRON=0 0 4 * * *
