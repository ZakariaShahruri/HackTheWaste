# Set these in Vercel → Project Settings → Environment Variables
VITE_API_BASE_URL=https://your-backend.railway.app

# WhatsApp reporting — digits only (country code + number, no "+", no spaces),
# the format wa.me expects, e.g. 32460000000
VITE_WHATSAPP_NUMBER=

# Only needed while on the Twilio WhatsApp Sandbox, which requires users to
# text "join <code>" once before the bot responds. Leave empty once on a
# production WhatsApp Business number — the join-code step is hidden automatically.
VITE_WHATSAPP_JOIN_CODE=

# Absolute origin for the social preview image (og:image). On Vercel the
# production URL is used automatically; set this when hosting elsewhere.
SITE_URL=
